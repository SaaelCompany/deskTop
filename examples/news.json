// Лента для адреса Widget.NewsUrl. Программа забирает этот JSON сама.
// Новое всплывающее окно появляется, только если id ещё не показывался этому пользователю.
// kind maintenance — технические работы. kind news — обычная новость.
// Чтобы оповестить снова, задайте новый id. Старый id второй раз не всплывает.
{
  "items": [
    {
      // Уникальный код сообщения. Для новой волны сбоя смените его, например phone-2026-10-12.
      "id": "phone-2026-10-11",

      // Заголовок во всплывающем окне и во вкладке «Новости».
      "title": "Сбой телефонии",

      // Текст, который увидит сотрудник.
      "body": "Массовая проблема со связью. Телефоны могут не работать. Если звонок не проходит, отправьте заявку кнопкой на рабочем столе.",

      // maintenance — янтарная отметка и заголовок «Технические работы». news — обычная новость.
      "kind": "maintenance",

      // Когда опубликовано. Более новое сообщение оказывается выше.
      "publishedAt": "2026-10-11T09:30:00",

      // Необязательная страница. Если адрес заполнен, щелчок по новости открывает его. Пусто — только текст.
      "url": ""
    },
    {
      // Код плановых работ. Повтор того же id не покажет окно ещё раз.
      "id": "maint-2026-10-10",
      "title": "Обслуживание файлового сервера",
      "body": "10 октября с 22:00 до 23:00 общая папка рабочего стола будет недоступна. На это время включится локальный стол.",
      "kind": "maintenance",
      "publishedAt": "2026-10-10T09:00:00",
      "url": "https://intranet.example/news/maint-2026-10-10"
    },
    {
      // Обычная новость, без пометки технических работ.
      "id": "news-printer-3",
      "title": "Новый принтер на третьем этаже",
      "body": "Принтер доступен по имени \\\\print\\floor3. Заявку на доступ можно отправить с виджета.",
      "kind": "news",
      "publishedAt": "2026-10-01T10:00:00",
      "url": "https://intranet.example/news/printer-3"
    }
  ]
}
