// Настройки DesktopSwitch. Скопируйте этот файл в config.json.
// Текст после // программа не читает. Обычный JSON без комментариев тоже подходит.
{
  // true — следить за сетью и показывать кнопку. false — программа сразу завершается.
  "Enabled": false,

  // false — стол переключается. true — только окно и значок, путь рабочего стола не меняется.
  "Preview": false,

  // Пустая строка — путь общего стола берётся из политики пользователя.
  // Явный UNC, например \\\\server\\share\\Desktop, нужен только чтобы зафиксировать путь.
  "NetworkDesktopPath": "",

  // При обрыве стол становится этой папкой. Ярлыки туда кладутся заранее.
  "LocalDesktopPath": "C:\\Users\\Public\\Desktop",

  // Когда переключать стол.
  // InternetOrShare — нет интернета или недоступна общая папка.
  // Internet — только когда нет интернета. Share — только когда недоступна общая папка.
  "Trigger": "InternetOrShare",

  // Пауза между проверками, в секундах. Значение меньше 5 программа поднимет до 5.
  "CheckIntervalSeconds": 5,

  // Сколько неудачных проверок подряд нужно, чтобы перейти на локальный стол.
  "FailuresBeforeSwitch": 2,

  // Сколько успешных проверок подряд нужно, чтобы вернуть сетевой стол.
  "SuccessesBeforeRestore": 2,

  // true — вернуть сетевой стол, когда связь снова есть. false — остаться на локальном.
  "RestoreWhenOnline": true,

  // true — перезапустить Проводник, чтобы новый стол стал виден. Его окна при этом закроются.
  "RestartExplorer": true,

  // true — показывать уведомления о смене стола, новостях и технических работах.
  "NotifyUser": true,

  // false — не копировать ярлыки в общий стол. true — копировать .lnk и .url, пока шара доступна.
  "SyncShortcutsWhileOnline": false,

  // Какие файлы копировать с общего стола. Документы и вложенные папки не копируются.
  "SyncExtensions": [".lnk", ".url"],

  // Как проверять интернет.
  "InternetCheck": {
    // true — сначала спросить статус сети Windows. false — сразу делать HTTP-запрос.
    "UseWindowsConnectivity": true,

    // Адреса проверки, если Windows не подтвердила интернет. Можно указать свой адрес интрасети.
    "ProbeUrls": [
      "http://www.msftconnecttest.com/connecttest.txt"
    ],

    // Начало ответа, которое должна вернуть проверка. Для своего адреса оставьте пустым: хватит ответа 200.
    "ExpectedProbeBody": "Microsoft Connect Test",

    // Сколько секунд ждать ответ. Если Windows уже сообщила, что интернета нет, ожидание сокращается до 2 секунд.
    "ProbeTimeoutSeconds": 5
  },

  // Сколько секунд ждать общую папку рабочего стола.
  "ShareProbeTimeoutSeconds": 4,

  // Файл журнала этого пользователя.
  "LogPath": "%LOCALAPPDATA%\\DesktopSwitch\\desktop-switch.log",

  // Память программы: режим стола, видимость кнопки, «поверх всех окон», ключи новостей и тексты за последние сутки.
  // Карточек в памяти не больше 30. Старее суток из вкладки пропадают.
  "StatePath": "%LOCALAPPDATA%\\DesktopSwitch\\state.json",

  // Максимальный размер журнала в байтах. Когда он превышен, старый журнал становится файлом .1, третий файл не появляется.
  "MaxLogBytes": 1048576,

  // Папка, которую открывает красная кнопка. Обычный локальный каталог.
  "EmergencyFolder": "",

  // Красная кнопка на экране. Заявок и окна новостей нет: нажатие открывает EmergencyFolder.
  "Widget": {
    // false — кнопки и окна нет, остаётся только слежение за столом.
    "Enabled": true,

    // Название в шапке окна.
    "Title": "Сервисная служба",

    // Картинка внутри круга: png или ico. Пусто — белый восклицательный знак.
    // Путь абсолютный либо относительно папки config.json, затем папки скрипта.
    "Icon": "",

    // Цвет круга, например #1F6B4A. Восемь цифр #1F6B4A80 задают ещё прозрачность фона. Пусто — красный #DC2626.
    "Color": "",

    // Непрозрачность только фона круга, от 0 до 100. Значок остаётся сплошным. 100 — сплошной фон.
    "Opacity": 100,

    // Угол экрана: BottomRight, BottomLeft, TopRight, TopLeft.
    "Corner": "BottomRight",

    // Отступ кнопки от края экрана, в точках.
    "Margin": 16,

    // Куда уходит заявка: Auto, Webhook, Jira или None.
    // Auto выбирает Webhook, если заполнен ServiceDeskApiUrl, иначе Jira, если заполнен JiraBaseUrl.
    "ServiceDesk": "Auto",

    // Страница портала для кнопки «Открыть портал». Можно писать {login}, {computer}, {project}, {projectId}.
    "ServiceDeskUrl": "",

    // Адрес, на который уходит POST с JSON. Это универсальный приёмник любого helpdesk, не Jira.
    "ServiceDeskApiUrl": "",

    // Пусто — вход текущей учётной записью Windows. Иначе PAT Jira или ключ вебхука. Пароль сюда не кладут.
    "ServiceDeskToken": "",

    // Пункты списка «Категория», когда заявка уходит на ServiceDeskApiUrl.
    "Categories": ["Инцидент", "Запрос обслуживания", "Вопрос"],

    // Проекты, из которых сотрудник выбирает. Пустой список — один приёмник, без выпадающего списка.
    "Projects": [],

    // Корень Jira Server или Data Center, без /servicedesk и без /browse. Пример: http://jira.company.local:8082
    "JiraBaseUrl": "",

    // Необязательный адрес JSON или RSS. Пусто — эта лента не используется.
    // Для оповещений из Jira сайт не нужен: заполните NewsJql ниже.
    "NewsUrl": "",

    // Запрос Jira. Программа сама читает найденные задачи и показывает их как новости.
    // Пусто — задачи Jira в ленту не попадают. Отдельная служба для этого не нужна.
    // В автоматизации Jira добавьте создание задачи с меткой desktop-news.
    // Пример: labels = desktop-news ORDER BY updated DESC
    "NewsJql": "",

    // Не список сотрудников и не доступ к заявке. Это одна техническая учётка в этом файле:
    // программа сама читает текст задачи и показывает его в окне. Людей в задачу добавлять не нужно.
    // Пусто — новости читаются той же учётной записью, что и заявки.
    "NewsToken": "",

    // В файле может стоять 10, но программа всё равно проверяет новости каждые 20 секунд.
    "NewsPollMinutes": 10
  }
}
