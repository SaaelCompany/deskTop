{
  "Note": "Скопируйте этот файл в config.json и поставьте Enabled в true. NetworkDesktopPath оставьте пустым: путь общего стола читается из политики пользователя и может отличаться. Права администратора пользователю не нужны. Программу положите на локальный диск. В углу экрана будет круглая кнопка: по ней открывается окно заявки и новостей. Логин Windows и имя компьютера программа берёт из сеанса сама. В ServiceDeskUrl можно указать {login} и {computer}.",
  "Enabled": false,
  "NetworkDesktopPath": "",
  "LocalDesktopPath": "%LOCALAPPDATA%\\DesktopSwitch\\LocalDesktop",
  "Trigger": "InternetOrShare",
  "CheckIntervalSeconds": 15,
  "FailuresBeforeSwitch": 2,
  "SuccessesBeforeRestore": 3,
  "RestoreWhenOnline": true,
  "RestartExplorer": true,
  "NotifyUser": true,
  "SyncShortcutsWhileOnline": true,
  "SyncExtensions": [".lnk", ".url"],
  "InternetCheck": {
    "UseWindowsConnectivity": true,
    "ProbeUrls": [
      "http://www.msftconnecttest.com/connecttest.txt"
    ],
    "ExpectedProbeBody": "Microsoft Connect Test",
    "ProbeTimeoutSeconds": 5
  },
  "ShareProbeTimeoutSeconds": 4,
  "LogPath": "%LOCALAPPDATA%\\DesktopSwitch\\desktop-switch.log",
  "StatePath": "%LOCALAPPDATA%\\DesktopSwitch\\state.json",
  "MaxLogBytes": 1048576,
  "Widget": {
    "Enabled": true,
    "Title": "Сервисная служба",
    "Corner": "BottomRight",
    "Margin": 16,
    "ServiceDeskUrl": "",
    "ServiceDeskApiUrl": "",
    "ServiceDeskToken": "",
    "NewsUrl": "",
    "NewsPollMinutes": 10
  }
}
