<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="D4E81B36-7A25-4C09-9F63-1B8A5E0C7D42"
           Name="Emergency folder"
           Language="1033"
           Version="1.2.43"
           Manufacturer="SaaelCompany"
           UpgradeCode="4048E9C4-7965-48DC-A23D-A4554966E57F">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Emergency folder is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="EmergencyFolder.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPCOMMENTS" Value="Shows a red button when the internet is down" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="SystemFolder" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Emergency folder">
          <Component Id="CmpMain" Guid="3F8A2C91-6D14-4E7B-A5C0-9B1E4D7F2A63" Win64="yes">
            <File Id="FilExe" Source="Emergency folder.exe" KeyPath="yes" />
            <File Id="FilMain" Source="EmergencyFolder.ps1" />
            <File Id="FilLogic" Source="EmergencyFolder.Logic.ps1" />
            <File Id="FilWidget" Source="EmergencyFolder.Widget.ps1" />
            <File Id="FilInstall" Source="Install-EmergencyFolder.ps1" />
            <File Id="FilUninstall" Source="Uninstall-EmergencyFolder.ps1" />
            <File Id="FilStatus" Source="Show-EmergencyFolderStatus.cmd" />
            <File Id="FilReadme" Source="README.md" />
            <RegistryValue Root="HKLM" Key="Software\SaaelCompany\Emergency folder" Name="Version" Type="string" Value="1.2.43" />
            <RegistryValue Root="HKLM" Key="Software\SaaelCompany\Emergency folder" Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Emergency folder" Type="string" Value="&quot;[INSTALLDIR]Emergency folder.exe&quot;" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="Emergency folder" Level="1">
      <ComponentRef Id="CmpMain" />
    </Feature>
  </Product>
</Wix>
