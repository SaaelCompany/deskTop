<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="C4A81E57-2D60-4F93-B8C1-6E9A3D5F0B28"
           Name="DesktopSwitch"
           Language="1033"
           Version="1.2.41"
           Manufacturer="SaaelCompany"
           UpgradeCode="4048E9C4-7965-48DC-A23D-A4554966E57F">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of DesktopSwitch is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="ProductIcon" SourceFile="DesktopSwitch.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />
    <Property Id="ARPCOMMENTS" Value="Shows a red button when the internet is down" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="SystemFolder" />
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="DesktopSwitch">
          <Component Id="CmpMain" Guid="7716602D-727B-4FF1-AA39-C1EE1F76386A" Win64="yes">
            <File Id="FilExe" Source="DesktopSwitch.exe" KeyPath="yes" />
            <File Id="FilMain" Source="DesktopSwitch.ps1" />
            <File Id="FilLogic" Source="DesktopSwitch.Logic.ps1" />
            <File Id="FilWidget" Source="DesktopSwitch.Widget.ps1" />
            <File Id="FilInstall" Source="Install-DesktopSwitch.ps1" />
            <File Id="FilUninstall" Source="Uninstall-DesktopSwitch.ps1" />
            <File Id="FilStatus" Source="Show-DesktopSwitchStatus.cmd" />
            <File Id="FilReadme" Source="README.md" />
            <RegistryValue Root="HKLM" Key="Software\SaaelCompany\DesktopSwitch" Name="Version" Type="string" Value="1.2.41" />
            <RegistryValue Root="HKLM" Key="Software\SaaelCompany\DesktopSwitch" Name="InstallDir" Type="string" Value="[INSTALLDIR]" />
            <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="DesktopSwitch" Type="string" Value="&quot;[INSTALLDIR]DesktopSwitch.exe&quot;" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Main" Title="DesktopSwitch" Level="1">
      <ComponentRef Id="CmpMain" />
    </Feature>
  </Product>
</Wix>
